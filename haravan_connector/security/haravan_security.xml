<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="res.groups.privilege" id="res_groups_privilege_haravan">
            <field name="name">Haravan</field>
            <field name="sequence">18</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_haravan_user" model="res.groups">
            <field name="name">Haravan / User</field>
            <field name="privilege_id" ref="res_groups_privilege_haravan"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>            
        </record>

        <record id="group_haravan_manager" model="res.groups">
            <field name="name">Haravan / Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_haravan"/>
            <field name="implied_ids" eval="[(4, ref('group_haravan_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
