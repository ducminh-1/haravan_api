<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_haravan_order_list" model="ir.ui.view">
        <field name="name">haravan.order.list</field>
        <field name="model">haravan.order</field>
        <field name="arch" type="xml">
            <list string="Haravan Orders"
                     decoration-danger="sync_state == 'error'"
                     decoration-success="sync_state == 'synced'">
                <field name="config_id"/>
                <field name="haravan_order_number"/>
                <field name="haravan_order_id"/>
                <field name="haravan_financial_status"/>
                <field name="haravan_fulfillment_status"/>
                <field name="odoo_sale_order_id"/>
                <field name="sync_state" widget="badge"
                       decoration-success="sync_state == 'synced'"
                       decoration-danger="sync_state == 'error'"/>
                <field name="last_synced"/>
                <button name="action_view_sale_order" type="object"
                        string="View SO" class="btn-sm btn-secondary"
                        invisible="not odoo_sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_haravan_order_form" model="ir.ui.view">
        <field name="name">haravan.order.form</field>
        <field name="model">haravan.order</field>
        <field name="arch" type="xml">
            <form string="Haravan Order Mapping">
                <header>
                    <button name="action_view_sale_order" type="object"
                            string="View Sale Order" class="btn-secondary"
                            invisible="not odoo_sale_order_id"/>
                    <field name="sync_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Haravan">
                            <field name="config_id"/>
                            <field name="haravan_order_id"/>
                            <field name="haravan_order_number"/>
                            <field name="haravan_financial_status"/>
                            <field name="haravan_fulfillment_status"/>
                        </group>
                        <group string="Odoo">
                            <field name="odoo_sale_order_id"/>
                            <field name="last_synced"/>
                            <field name="error_message" invisible="not error_message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_haravan_order_search" model="ir.ui.view">
        <field name="name">haravan.order.search</field>
        <field name="model">haravan.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="haravan_order_number"/>
                <field name="haravan_financial_status"/>
                <field name="config_id"/>
                <filter string="Synced" name="synced" domain="[('sync_state','=','synced')]"/>
                <filter string="Errors" name="errors" domain="[('sync_state','=','error')]"/>
                <filter string="Fulfilled" name="fulfilled"
                        domain="[('haravan_fulfillment_status','=','fulfilled')]"/>
                <group>
                    <filter string="Configuration" name="group_config"
                            context="{'group_by': 'config_id'}"/>
                    <filter string="Financial Status" name="group_financial"
                            context="{'group_by': 'haravan_financial_status'}"/>
                    <filter string="Sync State" name="group_sync_state"
                            context="{'group_by': 'sync_state'}"/>
                    <filter string="Order Month" name="group_date"
                            context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_haravan_order_pivot" model="ir.ui.view">
        <field name="name">haravan.order.pivot</field>
        <field name="model">haravan.order</field>
        <field name="arch" type="xml">
            <pivot string="Haravan Orders Analysis" sample="1">
                <field name="date_order" interval="month" type="row"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_haravan_order_graph" model="ir.ui.view">
        <field name="name">haravan.order.graph</field>
        <field name="model">haravan.order</field>
        <field name="arch" type="xml">
            <graph string="Haravan Orders Analysis" sample="1">
                <field name="date_order" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_haravan_order" model="ir.actions.act_window">
        <field name="name">Haravan Orders</field>
        <field name="res_model">haravan.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_haravan_order_search"/>
    </record>

</odoo>
