<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_haravan_webhook_list" model="ir.ui.view">
        <field name="name">haravan.webhook.list</field>
        <field name="model">haravan.webhook</field>
        <field name="arch" type="xml">
            <list string="Haravan Webhooks">
                <field name="config_id"/>
                <field name="topic"/>
                <field name="callback_url"/>
                <field name="last_triggered"/>
                <field name="trigger_count"/>
            </list>
        </field>
    </record>

    <record id="view_haravan_webhook_form" model="ir.ui.view">
        <field name="name">haravan.webhook.form</field>
        <field name="model">haravan.webhook</field>
        <field name="arch" type="xml">
            <form string="Haravan Webhook">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="topic"/>
                            <field name="format"/>
                        </group>
                        <group>
                            <field name="callback_url" readonly="1"/>
                            <field name="last_triggered" readonly="1"/>
                            <field name="trigger_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_haravan_webhook" model="ir.actions.act_window">
        <field name="name">Haravan Webhooks</field>
        <field name="res_model">haravan.webhook</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
