<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_haravan_sale_report_all" model="ir.actions.act_window">
        <field name="name">Haravan Sales Analysis</field>
        <field name="res_model">haravan.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('odoo_sale_order_id', '!=', False)]</field>
        <field name="context">{'group_by': ['date_order:month'], 'search_default_synced': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p><p>
                This report performs analysis on your Haravan orders mapping.
            </p>
        </field>
    </record>

</odoo>
